rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OTP requests — public read/write (unauthenticated, short-lived docs)
    match /otp_requests/{email} {
      allow read, write, delete: if true;
    }

    // item_master — public read so the landing page can display services
    // without requiring anonymous auth (which may be disabled in the console).
    // Writes still require a signed-in user.
    match /item_master/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Authenticated users only for everything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
